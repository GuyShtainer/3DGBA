{
 "_meta": {
  "units": "device px, origin top-left, y-down",
  "top_screen": [400, 240],
  "bottom_screen": [320, 240],
  "how_to_read": "Each unit is one physical screen. 'dynamic' rectangles are regions the plate PNG leaves for you to draw at runtime: game video (transparent hole), live text (fps/clock/names/RTT), scrolling lists, seat cards, and the reusable widgets (buttons, segmented controls, toggles, HUD chips, dots, battery) from the widget sheet. Everything NOT listed here is baked into the plate. Draw order per frame: (1) game video into the video rect, (2) the chrome plate PNG on top, (3) these dynamic items on top of the plate.",
  "geometry_is_theme_independent": "These rects are identical for all 6 themes. Only the plate PNG colors change per theme.",
  "notes": {
   "pause-bot-*": "The content panel (right of the 74px tab rail) scrolls vertically; rects with y+h > 240 sit below the fold. Tab rail x:0..74. Active-tab highlight (panel2 fill + 2px accent left border) is drawn in code per current tab.",
   "play-top": "Shared by in-game (dual & single) top, gamepad top, and smart top. 'letterbox base' is the full transparent field; 'game A video' is where the aspect-fit GBA frame lands. HUD bar (semi-transparent black) is baked into the plate.",
   "video_rects": "A plate PNG is fully transparent (alpha 0) across every video rect."
  }
 },
