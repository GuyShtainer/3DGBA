; tilt.v.pica — perspective-correct tilt/composite vertex shader (3DGBA phase 14, SPEC-render R5).
; A SIBLING of warp.v.pica, never an edit to it: warp.v.pica emits z=0,w=1 (affine) and the stereo
; grid warp + both bloom passes bind it (main.c:1071, 1224, 1276). A true-perspective tilt needs a
; real per-vertex w, so it gets its own program.
;
; Positions arrive in SCREEN pixels (CPU-projected: tilt_project -> calc_xform, source/tilt.c +
; main.c:709-715), carrying the homogeneous scale iq = 1/q with q = d/(d - w*sin a)
; (docs/kb/external/gen1-render.md finding 1, gen1recomp src/render/Tilt.lua:120-130).
;
; WHY THIS IS ENOUGH: gen1recomp reconstructs perspective-correct texturing across the tilted quad
; with a FRAGMENT shader (Renderer.lua:456-471 — vertex premultiplies UV by VertexScale, fragment
; divides it back) purely because LOVE is a 2D API with no clip-space w. The PICA200 has no
; fragment shader at all (3ds/gpu/shbin.h:11-12 lists only VERTEX_SHDR and GEOMETRY_SHDR —
; docs/kb/hd2d-octopath-3d.md §0.1) and does not need one: emitting a real clip w makes the
; fixed-function rasterizer interpolate attr/w and 1/w linearly in screen space and divide per
; pixel, which IS their trick (SPEC-render R1.3, agreement proven to 6e-14 px in R1.9).
;
; The projection uniform stays the ORTHO screen-pixel matrix every other pass already uses
; (Mtx_OrthoTilt(0, screenW, screenH, 0, 1, -1, true), main.c:1073) — not Mtx_PerspTilt. An ortho
; matrix P is linear with last row (0,0,0,1), so P*(x*iq, y*iq, 0, iq) = iq*[P*(x,y,0,1)]: the NDC
; is exactly the flat screen point and the entire projective content lands in w_clip = iq
; (SPEC-render R1.5). Emit iq = 1/q — the DEPTH, never q: inverted, the interpolated source
; coordinate is off by up to 31 px at 15 deg, a visibly wrong but plausible-looking tilt.

; Uniforms
.fvec projection[4]                 ; Mtx_OrthoTilt(0, screenW, screenH, 0, 1, -1, true)

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs: v0 = (x, y, iq)   screen px + homogeneous scale
;         v1 = (u, v)       texcoord, 0..1 of the 256/512 POT source
;         v2 = (r, g, b, a) vertex colour: dim tint / DoF alpha ramp / light MULTIPLY colour

.proc main
	; r0 = (x, y, 0, 1)
	mov r0.xy, v0.xy
	mov r0.z,  zeros
	mov r0.w,  ones

	; homogeneous scale: r0 = iq * (x, y, 0, 1) = (x*iq, y*iq, 0, iq)
	; -> after the linear ortho matrix, ndc is unchanged and w_clip = iq  (SPEC-render R1.5).
	; Kept in the shader, not folded into the CPU, so the VBO stays in SCREEN PIXELS — which is
	; what the pure-C module outputs and what the host suite asserts (R5.2.2).
	mul r0, v0.zzzz, r0

	; outpos = projection * r0
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	; pass through
	mov outtc0, v1
	mov outclr, v2

	end
.end
