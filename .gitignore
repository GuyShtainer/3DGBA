build/
*.3dsx
*.smdh
*.elf
*.cia
*.map
banner.bnr
external/
crash_dump_*.dmp

# NEVER commit copyrighted ROMs / saves / save-states (bring your own)
temp/
*.gba
*.sav
*.ss*

# on-device link logs pulled off the SD for debugging (not source)
netlogs/
3DGBA_net_*.txt
# ...EXCEPT the four frozen replay fixtures (D7c): checked in on purpose so
# test/host/test_trace_replay.c has a corpus. They are recorded link WORDS + counters
# (user gameplay data, no ROM code) — flagged to the release-legal-audit gate.
!test/fixtures/
!test/fixtures/3DGBA_net_*.txt

# generated by tools/build_assets.sh (regenerable)
data/*.bin
source/assets_gen.h
tools/.fontcache/

# OS junk / build listings
.DS_Store
*.lst

# phase-16 emulator harness — machine-local state, never source
tools/emutest/.venv/
tools/emutest/runs/
tools/emutest/state/
# per-instance trees (PHASE 21 S3: state-b/, runs-b/, az-b/ with the private Azahar
# bundle clone + its whole user dir incl. staged ROM fixtures — never commit)
tools/emutest/runs-*/
tools/emutest/state-*/
tools/emutest/az-*/
tools/emutest/emutest.mapsyms
# E2: the checked-in test fixtures must survive the global *.elf / *.map ignores
# (verified with `git check-ignore -v` — without these, a fresh clone has no
# tests/fixtures/tiny.elf or map_snippet.map and tests/run_host_tests.sh fails, so
# setup.sh aborts before the smoke gate).
!tools/emutest/tests/fixtures/tiny.elf
!tools/emutest/tests/fixtures/map_snippet.map

# phase 31: ROM-derived diorama fixtures + renders (generated by tools/diorama/diodump.py; never commit)
test/fixtures/dio_*

# agent worktrees
.claude/worktrees/

# phase 32: user-built voxel data and paks are never committed; the MIT tree art is the exception
*.pak
voxel/*.bin
!data/voxel_trees.bin
